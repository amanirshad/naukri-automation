# Copy to samconfig.toml after first `sam deploy --guided`, or use as reference.
# Region MUST stay ap-south-1 (Mumbai) so Naukri APIs see an India IP.

version = 0.1

[default.deploy.parameters]
stack_name = "naukri-profile-updater"
resolve_s3 = true
s3_prefix = "naukri-profile-updater"
region = "ap-south-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
# Pass secrets at deploy time (do not commit real values):
# parameter_overrides = "NaukriUsername=you@example.com NaukriPassword=*** NaukriProfileId=***"

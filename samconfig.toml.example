# Example SAM deploy config for Naukri Automation.
# Copy to samconfig.toml after first deploy. Keep region ap-south-1 (Mumbai).

version = 0.1

[default.deploy.parameters]
stack_name = "naukri-profile-updater"
resolve_s3 = true
s3_prefix = "naukri-profile-updater"
region = "ap-south-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
# parameter_overrides = "NaukriUsername=you@example.com NaukriPassword=*** NaukriProfileId=***"

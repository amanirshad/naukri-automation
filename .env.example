# Naukri credentials — copy this file to .env and fill in your values
# For Lambda, these are set via `sam deploy` parameters instead.
NAUKRI_USERNAME=your-email@example.com
NAUKRI_PASSWORD=your-password
NAUKRI_PROFILE_ID=your-profile-id

# Optional overrides (otherwise config/profile.json is used)
# NAUKRI_PROFILE_SUMMARY=
# NAUKRI_RESUME_HEADLINE=
